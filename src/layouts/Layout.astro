---
import '../styles/global.css';
import {
  getLanguageFromPath,
  getHreflangLinks,
  SUPPORTED_LANGUAGES,
  type SupportedLanguage
} from '../i18n/languages';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  noindex?: boolean;
  lang?: SupportedLanguage;
  structuredData?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'BDSM Test — Free BDSM Test Online & Dynamics Assessment',
  description = 'Take the free BDSM test online. Explore your kink BDSM test results, 20 nuanced BDSM test categories, and intimate relationship dynamics with 100% client-side privacy.',
  canonicalPath,
  ogType = 'website',
  ogImage = '/og-image.svg',
  noindex = false,
  lang,
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://freebdsmtest.com';
const currentPath = canonicalPath || Astro.url.pathname;
const currentLang: SupportedLanguage = lang || getLanguageFromPath(currentPath);
const langConfig = SUPPORTED_LANGUAGES.find((l) => l.code === currentLang) || SUPPORTED_LANGUAGES[0];

const canonicalURL = new URL(currentPath, siteUrl).toString().replace(/\/$/, currentPath === '/' || currentPath.endsWith('/') ? '/' : '');
const absoluteOgImage = new URL(ogImage, siteUrl).toString();

// Generate reciprocal hreflang links + x-default
const hreflangLinks = getHreflangLinks(currentPath, siteUrl);

// Baseline WebSite Structured Data
const baseWebsiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'BDSM Test',
  url: `${siteUrl}/`,
  description: 'Free, private, and anonymous online BDSM test and relationship dynamics assessment for adults (18+).',
  inLanguage: currentLang
};

const allSchemas = structuredData
  ? (Array.isArray(structuredData) ? [baseWebsiteSchema, ...structuredData] : [baseWebsiteSchema, structuredData])
  : [baseWebsiteSchema];
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon Suite (Google Search, Android, Apple iOS, and Desktop browsers) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="BDSM Test" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Canonical URL (Self-Referencing) -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Reciprocal Multilingual Hreflang Tags -->
    {hreflangLinks.map((hRef) => (
      <link rel="alternate" hreflang={hRef.lang} href={hRef.url} />
    ))}

    <!-- Title & SEO Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="BDSM Test" />
    <meta name="generator" content={Astro.generator} />

    <!-- Indexation & Robots Directives -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Open Graph Metadata -->
    <meta property="og:locale" content={langConfig.ogLocale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="BDSM Test" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BDSM Test — Online Dynamics Assessment" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Structured Data (JSON-LD) -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Anti-FOUC Theme Script (synchronous before paint) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored ? stored : (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <!-- Typography: Geist and Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-ink selection:bg-ink selection:text-canvas">
    <slot />
  </body>
</html>
