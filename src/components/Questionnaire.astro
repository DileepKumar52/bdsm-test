---
import {
  getLanguageFromPath,
  getLocalizedPath,
  type SupportedLanguage
} from '../i18n/languages';
import { getTranslations } from '../i18n/ui';
import { getLocalizedQuestions } from '../i18n/questions';
import { CATEGORY_TRANSLATIONS } from '../i18n/dimensions';
import {
  AGE_GROUPS,
  EXPERIENCE_LEVELS,
  PREVIOUS_TESTING,
  TEST_REASONS
} from '../data/onboarding';

interface Props {
  mode: 'quick' | 'comprehensive';
  lang?: SupportedLanguage;
}

const { mode, lang } = Astro.props;
const currentLang: SupportedLanguage = lang || getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(currentLang);

const allLocalizedQuestions = getLocalizedQuestions(currentLang);
const testQuestions = mode === 'quick' ? allLocalizedQuestions.filter((q) => q.isQuick) : allLocalizedQuestions;

const testTitle = mode === 'quick' 
  ? (currentLang === 'ja' ? 'クイックBDSM診断（24問）' : (currentLang === 'es' ? 'Test BDSM Rápido (24 Preguntas)' : (currentLang === 'fr' ? 'Test BDSM Rapide (24 Questions)' : (currentLang === 'de' ? 'BDSM Schnelltest (24 Fragen)' : (currentLang === 'pt' ? 'Teste BDSM Rápido (24 Perguntas)' : (currentLang === 'ko' ? '빠른 BDSM 테스트 (24문항)' : (currentLang === 'it' ? 'Test BDSM Rapido (24 Domande)' : 'Quick BDSM Assessment')))))))
  : (currentLang === 'ja' ? '総合BDSM診断（64問）' : (currentLang === 'es' ? 'Test BDSM Completo (64 Preguntas)' : (currentLang === 'fr' ? 'Test BDSM Complet (64 Questions)' : (currentLang === 'de' ? 'Ausführlicher BDSM Test (64 Fragen)' : (currentLang === 'pt' ? 'Teste BDSM Completo (64 Perguntas)' : (currentLang === 'ko' ? '정밀 종합 BDSM 테스트 (64문항)' : (currentLang === 'it' ? 'Test BDSM Completo (64 Domande)' : 'Comprehensive BDSM Assessment')))))));

const estimatedTime = mode === 'quick' ? '3–4 min' : '8–12 min';

const localizedLikertOptions = [
  { value: 0, label: t.likert.stronglyDisagree, hint: t.likert.stronglyDisagreeHint },
  { value: 25, label: t.likert.disagree, hint: t.likert.disagreeHint },
  { value: 50, label: t.likert.neutral, hint: t.likert.neutralHint },
  { value: 75, label: t.likert.agree, hint: t.likert.agreeHint },
  { value: 100, label: t.likert.stronglyAgree, hint: t.likert.stronglyAgreeHint }
] as const;

const resultsBaseUrl = getLocalizedPath(currentLang, '/results');
const homeUrl = getLocalizedPath(currentLang, '/');
---

<div
  class="relative min-h-[calc(100vh-4rem)] py-8 md:py-14"
  data-test-mode={mode}
  data-lang={currentLang}
  data-results-url={resultsBaseUrl}
  data-questions={JSON.stringify(testQuestions)}
  data-category-translations={JSON.stringify(CATEGORY_TRANSLATIONS[currentLang] || CATEGORY_TRANSLATIONS.en)}
  data-confirm-reset={t.questionnaire.retakeConfirm}
  data-q-label={t.questionnaire.questionLabel}
  data-q-of={t.questionnaire.of}
>
  <!-- Background Glow -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-64 hero-mesh"></div>

  <!-- ========================================================================= -->
  <!-- 1. PRE-TEST ONBOARDING SCREEN -->
  <!-- ========================================================================= -->
  <div id="onboarding-screen" class="relative mx-auto max-w-2xl px-4 sm:px-6">
    <div class="rounded-2xl border border-border bg-surface p-6 sm:p-10 shadow-xs">
      <!-- Onboarding Header -->
      <div class="border-b border-border pb-6">
        <div class="flex items-center gap-2">
          <span class="rounded bg-surface-raised px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase text-ink border border-border">
            {t.onboarding.badge}
          </span>
          <span class="text-border">•</span>
          <span class="text-xs text-mute">{mode === 'quick' ? `${testQuestions.length} Qs` : `${testQuestions.length} Qs`}</span>
        </div>
        <h1 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-[-0.8px] text-ink">
          {t.onboarding.title}
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-body leading-relaxed">
          {t.onboarding.description}
        </p>

        <!-- Privacy & Non-Scoring Guarantee -->
        <div class="mt-4 rounded-xl border border-border bg-surface-raised p-3.5 text-xs text-mute flex items-start gap-2.5">
          <svg class="h-4 w-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <div>
            <strong class="font-semibold text-ink">{t.onboarding.privacyNoticeBold}</strong>
            {t.onboarding.privacyNotice}
          </div>
        </div>
      </div>

      <!-- Onboarding Questions Form -->
      <form id="onboarding-form" class="mt-8 space-y-8">
        <!-- Q1: Age Group & Mandatory Confirmation -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold text-ink">
              {t.onboarding.q1Title} <span class="text-error">*</span>
            </h2>
            <span class="text-[11px] text-mute font-mono">{t.onboarding.q1Required}</span>
          </div>

          <!-- Mandatory 18+ Checkbox -->
          <div
            id="age-confirm-container"
            class="rounded-xl border border-border bg-surface-raised p-4 transition-colors"
          >
            <label class="flex items-start gap-3 cursor-pointer select-none">
              <input
                type="checkbox"
                id="age-confirm-checkbox"
                required
                class="mt-0.5 h-4 w-4 rounded border-border text-ink focus:ring-1 focus:ring-link bg-surface cursor-pointer"
              />
              <div class="text-xs">
                <span class="font-medium text-ink">
                  {t.onboarding.ageConfirmText}
                </span>
                <p class="mt-0.5 text-mute">
                  {t.onboarding.ageConfirmSub}
                </p>
              </div>
            </label>
            <div id="age-confirm-error" class="hidden mt-2 text-[11px] font-medium text-error pl-7">
              {t.onboarding.ageConfirmError}
            </div>
          </div>

          <!-- Age Group Selection (Optional) -->
          <div>
            <label class="block text-xs font-medium text-body mb-2">
              {t.onboarding.ageSelectLabel}
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              {AGE_GROUPS.map((group) => (
                <label class="onboarding-pill flex items-center justify-center rounded-xl border border-border bg-surface p-2.5 text-xs text-ink hover:border-ink hover:bg-surface-raised cursor-pointer transition-all select-none">
                  <input
                    type="radio"
                    name="ageGroup"
                    value={group}
                    class="sr-only"
                  />
                  <span>{group}</span>
                </label>
              ))}
            </div>
          </div>
        </div>

        <!-- Q2: BDSM Experience (Adapts Terminology) -->
        <div class="space-y-3 border-t border-border pt-6">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold text-ink">
              {t.onboarding.q2Title}
            </h2>
            <span class="text-[11px] text-link font-medium">{t.onboarding.q2Optional}</span>
          </div>
          <p class="text-xs text-body leading-relaxed">
            {t.onboarding.q2Subtitle}
          </p>

          <div class="space-y-2">
            {EXPERIENCE_LEVELS.map((exp) => {
              const expTrans = t.experienceOptions[exp.id] || exp;
              return (
                <label class="onboarding-exp-card group flex items-start gap-3 rounded-xl border border-border bg-surface p-3.5 text-left hover:border-ink hover:bg-surface-raised cursor-pointer transition-all select-none">
                  <input
                    type="radio"
                    name="experience"
                    value={exp.id}
                    checked={exp.id === 'some'}
                    class="sr-only"
                  />
                  <div class="radio-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-border mt-0.5 group-hover:border-ink transition-colors">
                    <div class="radio-dot h-2 w-2 rounded-full bg-transparent transition-colors"></div>
                  </div>
                  <div>
                    <div class="text-xs font-semibold text-ink flex items-center gap-2">
                      <span>{expTrans.label}</span>
                      <span class="rounded bg-surface-raised border border-border px-1.5 py-0.2 font-mono text-[9px] text-mute">
                        {expTrans.tag}
                      </span>
                    </div>
                    <p class="text-[11px] text-mute mt-0.5 leading-normal">
                      {expTrans.description}
                    </p>
                  </div>
                </label>
              );
            })}
          </div>
        </div>

        <!-- Q3: Previous Testing Experience (Optional) -->
        <div class="space-y-3 border-t border-border pt-6">
          <h2 class="text-sm font-semibold text-ink">
            {t.onboarding.q3Title} <span class="text-mute font-normal">({t.onboarding.q3Optional})</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {PREVIOUS_TESTING.map((opt) => (
              <label class="onboarding-pill flex items-center gap-2.5 rounded-xl border border-border bg-surface p-3 text-xs text-ink hover:border-ink hover:bg-surface-raised cursor-pointer transition-all select-none">
                <input
                  type="radio"
                  name="previousTests"
                  value={opt}
                  class="sr-only"
                />
                <span>{opt}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Q4: Reason for Taking the Test (Optional) -->
        <div class="space-y-3 border-t border-border pt-6">
          <h2 class="text-sm font-semibold text-ink">
            {t.onboarding.q4Title} <span class="text-mute font-normal">({t.onboarding.q4Optional})</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {TEST_REASONS.map((opt) => (
              <label class="onboarding-pill flex items-center gap-2.5 rounded-xl border border-border bg-surface p-3 text-xs text-ink hover:border-ink hover:bg-surface-raised cursor-pointer transition-all select-none">
                <input
                  type="radio"
                  name="reason"
                  value={opt}
                  class="sr-only"
                />
                <span>{opt}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Submit & Navigation Controls -->
        <div class="border-t border-border pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
          <a
            href={homeUrl}
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-full border border-border bg-surface px-5 py-2.5 text-xs font-medium text-ink hover:bg-surface-raised transition-colors"
          >
            ← {t.common.backHome}
          </a>

          <button
            type="submit"
            id="start-assessment-btn"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-btn-primary px-8 py-3 text-xs font-semibold text-btn-primary-text shadow-xs hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
          >
            <span>{t.onboarding.startButton}</span>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 2. QUESTIONNAIRE VIEW (Initially Hidden if onboarding not done) -->
  <!-- ========================================================================= -->
  <div id="questionnaire-view" class="hidden relative mx-auto max-w-3xl px-4 sm:px-6">
    <!-- Header Card -->
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-border pb-6">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-mute">
            {mode === 'quick' ? 'Quick Mode' : 'In-Depth Mode'}
          </span>
          <span class="text-border">•</span>
          <span class="text-xs text-mute">{estimatedTime}</span>
          <span class="text-border">•</span>
          <button
            id="edit-experience-btn"
            type="button"
            class="rounded-full bg-surface-raised border border-border px-2.5 py-0.5 font-mono text-[10px] text-ink hover:border-ink transition-colors cursor-pointer"
            title="Adjust phrasing adaptation"
          >
            <span id="active-experience-tag">{t.onboarding.expModeLabel} {t.experienceOptions.some.tag}</span> ✎
          </button>
        </div>
        <h2 class="text-2xl font-semibold tracking-[-0.8px] text-ink sm:text-3xl mt-1">
          {testTitle}
        </h2>
      </div>

      <!-- Controls: Auto-advance & Reset -->
      <div class="flex items-center gap-3">
        <label class="flex items-center gap-2 text-xs text-body cursor-pointer select-none">
          <input
            type="checkbox"
            id="auto-advance-toggle"
            checked
            class="h-3.5 w-3.5 rounded border-border text-ink focus:ring-1 focus:ring-link bg-surface"
          />
          <span>Auto-advance</span>
        </label>
        <button
          id="reset-test-btn"
          type="button"
          class="rounded-md border border-border bg-surface px-2.5 py-1 text-xs font-medium text-body hover:bg-surface-raised hover:text-ink transition-colors cursor-pointer"
          title="Clear progress and start from question 1"
        >
          Reset
        </button>
      </div>
    </div>

    <!-- Progress Indicator Bar -->
    <div class="mb-8">
      <div class="flex items-center justify-between text-xs font-medium text-body mb-2">
        <span id="question-counter">{t.questionnaire.questionLabel} 1 {t.questionnaire.of} {testQuestions.length}</span>
        <span id="progress-percent" class="font-mono text-xs text-ink font-semibold">0% Completed</span>
      </div>
      <div class="h-2 w-full overflow-hidden rounded-full bg-surface-raised border border-border">
        <div
          id="progress-bar-fill"
          class="h-full bg-ink transition-all duration-300 ease-out"
          style="width: 0%;"
        ></div>
      </div>
    </div>

    <!-- Active Question Card -->
    <div
      id="question-card"
      class="rounded-2xl border border-border bg-surface p-6 md:p-10 shadow-[0_1px_3px_rgba(0,0,0,0.05)] transition-all"
    >
      <div class="mb-4 flex items-center justify-between">
        <span
          id="question-category"
          class="inline-flex items-center rounded-full bg-surface-raised border border-border px-3 py-1 font-mono text-[11px] font-medium text-body"
        >
          Category
        </span>
        <span class="text-xs text-mute hidden sm:inline">Use keys 1–5 or click an option</span>
      </div>

      <!-- Question Text -->
      <h3
        id="question-text"
        class="min-h-[72px] text-lg font-semibold leading-relaxed tracking-[-0.4px] text-ink sm:text-2xl sm:leading-snug"
      >
        {t.common.loading}
      </h3>

      <!-- Context Note / Definition Banner (Shown for beginners & exploring users) -->
      <div
        id="question-context-note"
        class="hidden mt-3 rounded-xl border border-border bg-surface-raised p-3 text-xs text-body leading-relaxed flex items-start gap-2"
      >
        <span class="font-mono text-[10px] uppercase font-semibold text-link bg-link/10 rounded px-1.5 py-0.5 shrink-0 mt-0.5">
          Context
        </span>
        <span id="question-context-text"></span>
      </div>

      <!-- Likert Options -->
      <div class="mt-8 space-y-3" id="options-container" role="radiogroup" aria-label="Likert Options">
        {localizedLikertOptions.map((opt, index) => (
          <button
            type="button"
            data-value={opt.value}
            data-index={index + 1}
            class="likert-option group flex w-full items-center justify-between rounded-xl border border-border bg-surface p-4 text-left transition-all hover:border-ink hover:bg-surface-raised focus:outline-none focus-visible:ring-2 focus-visible:ring-link cursor-pointer"
          >
            <div class="flex items-center gap-3.5">
              <span class="flex h-6 w-6 items-center justify-center rounded-full border border-border font-mono text-xs font-medium text-mute group-hover:border-ink group-hover:text-ink">
                {index + 1}
              </span>
              <div>
                <div class="text-sm font-medium text-ink">
                  {opt.label}
                </div>
                <div class="text-xs text-mute">
                  {opt.hint}
                </div>
              </div>
            </div>
            <div class="option-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-border opacity-0 group-hover:opacity-100 transition-opacity">
              <div class="h-2 w-2 rounded-full bg-ink"></div>
            </div>
          </button>
        ))}
      </div>

      <!-- Card Navigation Controls -->
      <div class="mt-8 flex items-center justify-between border-t border-border pt-6">
        <button
          id="prev-btn"
          type="button"
          disabled
          class="rounded-full border border-border bg-surface px-4 py-2 text-xs font-medium text-body hover:bg-surface-raised hover:text-ink disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer"
        >
          {t.questionnaire.previousBtn}
        </button>

        <div class="flex items-center gap-2">
          <button
            id="next-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-full bg-btn-primary px-5 py-2 text-xs font-medium text-btn-primary-text hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer shadow-xs"
          >
            <span>{t.questionnaire.nextBtn}</span>
          </button>
          <button
            id="finish-btn"
            type="button"
            class="hidden inline-flex items-center gap-2 rounded-full bg-btn-primary px-6 py-2.5 text-xs font-semibold text-btn-primary-text shadow-xs hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
          >
            <span>{t.questionnaire.finishBtn}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Quick Navigation Jump Drawer -->
    <div class="mt-8 rounded-xl border border-border bg-surface p-4">
      <div class="mb-3 flex items-center justify-between">
        <span class="font-mono text-xs font-medium text-mute">Question Map</span>
        <span id="answered-count" class="text-xs text-body">0 answered</span>
      </div>
      <div id="jump-grid" class="flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1">
        {testQuestions.map((_, i) => (
          <button
            type="button"
            data-jump-index={i}
            class="jump-dot flex h-7 w-7 items-center justify-center rounded-md border border-border bg-surface text-[11px] font-mono text-mute hover:border-ink hover:text-ink transition-all cursor-pointer"
          >
            {i + 1}
          </button>
        ))}
      </div>
    </div>

    <!-- Privacy & Anonymous Guarantee -->
    <div class="mt-8 flex items-center justify-center gap-2 text-xs text-mute">
      <svg class="h-3.5 w-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      <span>Zero data leaves your browser. Processed entirely on your machine.</span>
    </div>
  </div>
</div>

<script>
  import { calculateScores, encodeScores } from '../utils/scoring';
  import type { Question } from '../data/questions';
  import type { OnboardingState } from '../data/onboarding';

  // Client-Side Runner
  const container = document.querySelector('[data-test-mode]') as HTMLElement;
  if (container) {
    const mode = container.getAttribute('data-test-mode') as 'quick' | 'comprehensive';
    const resultsUrl = container.getAttribute('data-results-url') || '/results';
    const confirmResetMsg = container.getAttribute('data-confirm-reset') || 'Are you sure you want to reset?';
    const qLabel = container.getAttribute('data-q-label') || 'Question';
    const qOf = container.getAttribute('data-q-of') || 'of';
    const categoryTranslations: Record<string, string> = JSON.parse(container.getAttribute('data-category-translations') || '{}');
    const questions: Question[] = JSON.parse(container.getAttribute('data-questions') || '[]');

    const storageAnswersKey = `bdsm_test_answers_${mode}`;
    const storageOnboardingKey = `bdsm_onboarding_${mode}`;
    const autoAdvanceKey = 'bdsm_auto_advance';

    // State
    let currentIndex = 0;
    let answers: Record<number, number> = {};
    let autoAdvance = localStorage.getItem(autoAdvanceKey) !== 'false';

    // Onboarding State
    let onboarding: OnboardingState = {
      ageGroup: '',
      ageConfirmed: false,
      experience: 'some',
      previousTests: '',
      reason: ''
    };

    // Load saved answers
    try {
      const saved = localStorage.getItem(storageAnswersKey);
      if (saved) {
        answers = JSON.parse(saved);
      }
    } catch (e) {}

    // Load saved onboarding state
    try {
      const savedOnboarding = localStorage.getItem(storageOnboardingKey);
      if (savedOnboarding) {
        onboarding = { ...onboarding, ...JSON.parse(savedOnboarding) };
      }
    } catch (e) {}

    // DOM Elements - Onboarding
    const onboardingScreen = document.getElementById('onboarding-screen');
    const onboardingForm = document.getElementById('onboarding-form') as HTMLFormElement;
    const ageConfirmCheckbox = document.getElementById('age-confirm-checkbox') as HTMLInputElement;
    const ageConfirmContainer = document.getElementById('age-confirm-container');
    const ageConfirmError = document.getElementById('age-confirm-error');

    // DOM Elements - Questionnaire
    const questionnaireView = document.getElementById('questionnaire-view');
    const questionCounter = document.getElementById('question-counter');
    const progressPercent = document.getElementById('progress-percent');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const questionCategory = document.getElementById('question-category');
    const questionText = document.getElementById('question-text');
    const questionContextNote = document.getElementById('question-context-note');
    const questionContextText = document.getElementById('question-context-text');
    const options = document.querySelectorAll('.likert-option');
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    const finishBtn = document.getElementById('finish-btn') as HTMLButtonElement;
    const answeredCount = document.getElementById('answered-count');
    const jumpDots = document.querySelectorAll('.jump-dot');
    const autoAdvanceToggle = document.getElementById('auto-advance-toggle') as HTMLInputElement;
    const resetBtn = document.getElementById('reset-test-btn');
    const editExperienceBtn = document.getElementById('edit-experience-btn');
    const activeExperienceTag = document.getElementById('active-experience-tag');

    // Initialize Onboarding Form values
    if (onboardingScreen && onboardingForm) {
      if (onboarding.ageConfirmed && ageConfirmCheckbox) {
        ageConfirmCheckbox.checked = true;
      }
      if (onboarding.ageGroup) {
        const rad = onboardingForm.querySelector(`input[name="ageGroup"][value="${onboarding.ageGroup}"]`) as HTMLInputElement;
        if (rad) {
          rad.checked = true;
          rad.closest('.onboarding-pill')?.classList.add('border-ink', 'bg-surface-raised', 'font-medium');
        }
      }
      if (onboarding.experience) {
        const rad = onboardingForm.querySelector(`input[name="experience"][value="${onboarding.experience}"]`) as HTMLInputElement;
        if (rad) {
          rad.checked = true;
          updateExperienceCardStyles(rad);
        }
      }
      if (onboarding.previousTests) {
        const rad = onboardingForm.querySelector(`input[name="previousTests"][value="${onboarding.previousTests}"]`) as HTMLInputElement;
        if (rad) {
          rad.checked = true;
          rad.closest('.onboarding-pill')?.classList.add('border-ink', 'bg-surface-raised', 'font-medium');
        }
      }
      if (onboarding.reason) {
        const rad = onboardingForm.querySelector(`input[name="reason"][value="${onboarding.reason}"]`) as HTMLInputElement;
        if (rad) {
          rad.checked = true;
          rad.closest('.onboarding-pill')?.classList.add('border-ink', 'bg-surface-raised', 'font-medium');
        }
      }

      // Pill click styling
      onboardingForm.querySelectorAll('.onboarding-pill input[type="radio"]').forEach((input) => {
        input.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          const groupName = target.name;
          onboardingForm.querySelectorAll(`input[name="${groupName}"]`).forEach((sibling) => {
            sibling.closest('.onboarding-pill')?.classList.remove('border-ink', 'bg-surface-raised', 'font-medium');
          });
          target.closest('.onboarding-pill')?.classList.add('border-ink', 'bg-surface-raised', 'font-medium');
        });
      });

      // Experience card radio styling
      onboardingForm.querySelectorAll('.onboarding-exp-card input[type="radio"]').forEach((input) => {
        input.addEventListener('change', (e) => {
          updateExperienceCardStyles(e.target as HTMLInputElement);
        });
      });

      function updateExperienceCardStyles(activeInput: HTMLInputElement) {
        onboardingForm.querySelectorAll('.onboarding-exp-card').forEach((card) => {
          card.classList.remove('border-ink', 'bg-surface-raised');
          const dot = card.querySelector('.radio-dot');
          dot?.classList.remove('bg-ink');
          dot?.classList.add('bg-transparent');
        });
        const activeCard = activeInput.closest('.onboarding-exp-card');
        activeCard?.classList.add('border-ink', 'bg-surface-raised');
        const activeDot = activeCard?.querySelector('.radio-dot');
        activeDot?.classList.remove('bg-transparent');
        activeDot?.classList.add('bg-ink');
      }

      // Form submission validation
      onboardingForm.addEventListener('submit', (e) => {
        e.preventDefault();

        // 18+ Confirmation Gate
        if (!ageConfirmCheckbox.checked) {
          ageConfirmContainer?.classList.add('border-error');
          ageConfirmError?.classList.remove('hidden');
          ageConfirmCheckbox.focus();
          return;
        }

        ageConfirmContainer?.classList.remove('border-error');
        ageConfirmError?.classList.add('hidden');

        // Collect answers
        const formData = new FormData(onboardingForm);
        onboarding.ageConfirmed = true;
        onboarding.ageGroup = (formData.get('ageGroup') as string) || '';
        onboarding.experience = (formData.get('experience') as any) || 'some';
        onboarding.previousTests = (formData.get('previousTests') as string) || '';
        onboarding.reason = (formData.get('reason') as string) || '';

        try {
          localStorage.setItem(storageOnboardingKey, JSON.stringify(onboarding));
        } catch (err) {}

        startQuestionnaire();
      });
    }

    if (editExperienceBtn) {
      editExperienceBtn.addEventListener('click', () => {
        questionnaireView?.classList.add('hidden');
        onboardingScreen?.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    function updateExperienceTag() {
      if (!activeExperienceTag) return;
      activeExperienceTag.textContent = `Mode: ${onboarding.experience.toUpperCase()}`;
    }

    function startQuestionnaire() {
      onboardingScreen?.classList.add('hidden');
      questionnaireView?.classList.remove('hidden');
      updateExperienceTag();
      renderQuestion();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Check if onboarding is already completed
    if (onboarding.ageConfirmed) {
      startQuestionnaire();
    } else {
      onboardingScreen?.classList.remove('hidden');
      questionnaireView?.classList.add('hidden');
    }

    if (autoAdvanceToggle) {
      autoAdvanceToggle.checked = autoAdvance;
      autoAdvanceToggle.addEventListener('change', () => {
        autoAdvance = autoAdvanceToggle.checked;
        localStorage.setItem(autoAdvanceKey, String(autoAdvance));
      });
    }

    function saveAnswers() {
      try {
        localStorage.setItem(storageAnswersKey, JSON.stringify(answers));
      } catch (e) {}
    }

    function getQuestionContent(q: Question, experience: string): { text: string; note?: string } {
      if (experience === 'new') {
        return {
          text: q.adaptations?.beginnerText || q.text,
          note: q.adaptations?.beginnerNote
        };
      }
      if (experience === 'exploring') {
        return {
          text: q.adaptations?.exploringText || q.text,
          note: q.adaptations?.exploringNote || q.adaptations?.beginnerNote
        };
      }
      if (experience === 'experienced') {
        return {
          text: q.adaptations?.experiencedText || q.text
        };
      }
      return { text: q.text };
    }

    function renderQuestion() {
      const q = questions[currentIndex];
      if (!q) return;

      // Question Category with localization
      if (questionCategory) {
        questionCategory.textContent = categoryTranslations[q.category] || q.category;
      }

      // Adaptive Question Text
      const adapted = getQuestionContent(q, onboarding.experience);
      if (questionText) {
        questionText.textContent = adapted.text;
      }

      // Context note
      if (questionContextNote && questionContextText) {
        if (adapted.note) {
          questionContextText.textContent = adapted.note;
          questionContextNote.classList.remove('hidden');
        } else {
          questionContextNote.classList.add('hidden');
        }
      }

      // Counter & Progress
      if (questionCounter) {
        questionCounter.textContent = `${qLabel} ${currentIndex + 1} ${qOf} ${questions.length}`;
      }

      const totalAnswered = Object.keys(answers).length;
      const pct = Math.round((totalAnswered / questions.length) * 100);
      if (progressPercent) {
        progressPercent.textContent = `${pct}%`;
      }
      if (progressBarFill) {
        progressBarFill.style.width = `${pct}%`;
      }
      if (answeredCount) {
        answeredCount.textContent = `${totalAnswered} / ${questions.length}`;
      }

      // Selected option highlight
      const currentVal = answers[q.id];
      options.forEach((opt) => {
        const val = Number(opt.getAttribute('data-value'));
        const check = opt.querySelector('.option-check');
        if (currentVal !== undefined && currentVal === val) {
          opt.classList.add('border-ink', 'bg-surface-raised', 'ring-1', 'ring-ink');
          check?.classList.remove('opacity-0');
          check?.classList.add('opacity-100');
        } else {
          opt.classList.remove('border-ink', 'bg-surface-raised', 'ring-1', 'ring-ink');
          check?.classList.remove('opacity-100');
          check?.classList.add('opacity-0');
        }
      });

      // Jump dots
      jumpDots.forEach((dot, idx) => {
        const qId = questions[idx]?.id;
        const isAnswered = qId !== undefined && answers[qId] !== undefined;
        const isCurrent = idx === currentIndex;

        dot.classList.remove('ring-2', 'ring-ink', 'font-semibold', 'bg-btn-primary', 'text-btn-primary-text', 'border-btn-primary');

        if (isCurrent) {
          dot.classList.add('ring-2', 'ring-ink', 'font-semibold');
        }

        if (isAnswered) {
          dot.classList.remove('text-mute', 'border-border');
          dot.classList.add('bg-btn-primary', 'text-btn-primary-text', 'border-btn-primary');
        }
      });

      if (prevBtn) {
        prevBtn.disabled = currentIndex === 0;
      }

      const isLast = currentIndex === questions.length - 1;
      const allAnswered = Object.keys(answers).length >= questions.length;

      if (isLast || allAnswered) {
        if (finishBtn) finishBtn.classList.remove('hidden');
        if (nextBtn && isLast) nextBtn.classList.add('hidden');
      } else {
        if (finishBtn) finishBtn.classList.add('hidden');
        if (nextBtn) nextBtn.classList.remove('hidden');
      }
    }

    function selectOption(val: number) {
      const q = questions[currentIndex];
      if (!q) return;

      answers[q.id] = val;
      saveAnswers();
      renderQuestion();

      if (autoAdvance) {
        setTimeout(() => {
          if (currentIndex < questions.length - 1) {
            currentIndex++;
            renderQuestion();
          } else {
            completeTest();
          }
        }, 220);
      }
    }

    function completeTest() {
      const scores = calculateScores(answers, questions as any);
      const encoded = encodeScores(scores);
      localStorage.setItem('bdsm_latest_results', JSON.stringify({ mode, scores, date: new Date().toISOString() }));
      window.location.href = `${resultsUrl}?data=${encoded}&mode=${mode}`;
    }

    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        const val = Number(opt.getAttribute('data-value'));
        selectOption(val);
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex--;
          renderQuestion();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentIndex < questions.length - 1) {
          currentIndex++;
          renderQuestion();
        }
      });
    }

    if (finishBtn) {
      finishBtn.addEventListener('click', () => {
        completeTest();
      });
    }

    jumpDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const jumpIdx = Number(dot.getAttribute('data-jump-index'));
        if (!isNaN(jumpIdx) && jumpIdx >= 0 && jumpIdx < questions.length) {
          currentIndex = jumpIdx;
          renderQuestion();
        }
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (confirm(confirmResetMsg)) {
          answers = {};
          currentIndex = 0;
          localStorage.removeItem(storageAnswersKey);
          renderQuestion();
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (questionnaireView?.classList.contains('hidden')) return;

      if (['1', '2', '3', '4', '5'].includes(e.key)) {
        const keyIndex = Number(e.key) - 1;
        const targetOption = options[keyIndex];
        if (targetOption) {
          const val = Number(targetOption.getAttribute('data-value'));
          selectOption(val);
        }
      } else if (e.key === 'ArrowLeft') {
        if (currentIndex > 0) {
          currentIndex--;
          renderQuestion();
        }
      } else if (e.key === 'ArrowRight') {
        if (currentIndex < questions.length - 1) {
          currentIndex++;
          renderQuestion();
        }
      }
    });

    for (let i = 0; i < questions.length; i++) {
      if (answers[questions[i].id] === undefined) {
        currentIndex = i;
        break;
      }
    }
  }
</script>
