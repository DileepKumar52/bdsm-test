---
import {
  SUPPORTED_LANGUAGES,
  getLanguageFromPath,
  getLocalizedPath,
  type SupportedLanguage
} from '../i18n/languages';
import { getTranslations } from '../i18n/ui';

interface Props {
  activePath?: string;
  lang?: SupportedLanguage;
}

const { activePath = '/' } = Astro.props;
const currentLang: SupportedLanguage = Astro.props.lang || getLanguageFromPath(activePath || Astro.url.pathname);
const t = getTranslations(currentLang);
const currentLangConfig = SUPPORTED_LANGUAGES.find((l) => l.code === currentLang) || SUPPORTED_LANGUAGES[0];

const navDefinitions = [
  { label: t.nav.home, path: '/' },
  { label: t.nav.quickTest, path: '/test/quick' },
  { label: t.nav.comprehensiveTest, path: '/test/comprehensive' },
  { label: t.nav.dimensions, path: '/dimensions' },
  { label: t.nav.compare, path: '/compare' },
  { label: t.nav.about, path: '/about' },
];

const homeUrl = getLocalizedPath(currentLang, '/');
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-canvas/90 backdrop-blur-md transition-colors">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- Brand Logo -->
    <a href={homeUrl} class="group flex items-center gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-link">
      <div class="flex h-8 w-8 items-center justify-center rounded-md bg-btn-primary text-btn-primary-text font-mono text-xs font-semibold tracking-wider transition-transform group-hover:scale-105">
        BT
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-semibold tracking-[-0.4px] text-ink text-base">BDSM Test</span>
        <span class="rounded bg-surface-raised px-1.5 py-0.5 font-mono text-[10px] font-medium text-body border border-border">18+</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {navDefinitions.map((item) => {
        const itemUrl = getLocalizedPath(currentLang, item.path);
        const isActive = activePath === itemUrl || (item.path === '/' && activePath === homeUrl);
        return (
          <a
            href={itemUrl}
            class:list={[
              'rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-link',
              isActive
                ? 'bg-btn-primary text-btn-primary-text'
                : 'text-body hover:text-ink hover:bg-surface-raised'
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Desktop: Language Selector + Theme Toggle) -->
    <div class="hidden md:flex items-center gap-2.5">
      <!-- Language Selector Dropdown -->
      <div class="relative inline-block text-left" id="desktop-lang-dropdown">
        <button
          type="button"
          id="desktop-lang-btn"
          aria-haspopup="true"
          aria-expanded="false"
          class="flex h-9 items-center gap-1.5 rounded-full border border-border bg-surface px-3 text-xs font-medium text-ink hover:bg-surface-raised transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-link cursor-pointer"
          title={t.header.selectLanguage}
        >
          <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <span>{currentLangConfig.nativeName}</span>
          <svg class="h-3 w-3 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="desktop-lang-menu"
          class="hidden absolute right-0 mt-2 w-44 rounded-xl border border-border bg-surface py-1.5 shadow-lg z-50 transition-all"
        >
          {SUPPORTED_LANGUAGES.map((langOption) => {
            const targetUrl = getLocalizedPath(langOption.code as SupportedLanguage, activePath);
            const isSelected = langOption.code === currentLang;
            return (
              <a
                href={targetUrl}
                class:list={[
                  'flex items-center justify-between px-3.5 py-2 text-xs transition-colors',
                  isSelected
                    ? 'bg-surface-raised font-semibold text-ink'
                    : 'text-body hover:bg-surface-raised hover:text-ink'
                ]}
              >
                <span>{langOption.nativeName}</span>
                <span class="font-mono text-[10px] text-mute uppercase">{langOption.code}</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Theme Toggle Button -->
      <button
        type="button"
        class="theme-toggle-btn flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface text-ink hover:bg-surface-raised transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-link cursor-pointer"
        aria-label="Toggle light and dark theme"
        title="Toggle color theme"
      >
        <svg class="sun-icon hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="moon-icon hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <!-- Mobile Header Actions (Language Select + Theme Toggle + Hamburger) -->
    <div class="flex items-center gap-1.5 md:hidden">
      <!-- Mobile Language Selector Button -->
      <div class="relative" id="mobile-lang-dropdown">
        <button
          type="button"
          id="mobile-lang-btn"
          aria-label={t.header.selectLanguage}
          aria-expanded="false"
          class="flex h-9 items-center gap-1 rounded-full border border-border bg-surface px-2.5 text-xs font-mono font-medium text-ink hover:bg-surface-raised cursor-pointer"
        >
          <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <span class="uppercase">{currentLang}</span>
        </button>

        <div
          id="mobile-lang-menu"
          class="hidden absolute right-0 mt-2 w-44 rounded-xl border border-border bg-surface py-1.5 shadow-lg z-50"
        >
          {SUPPORTED_LANGUAGES.map((langOption) => {
            const targetUrl = getLocalizedPath(langOption.code as SupportedLanguage, activePath);
            const isSelected = langOption.code === currentLang;
            return (
              <a
                href={targetUrl}
                class:list={[
                  'flex items-center justify-between px-3.5 py-2 text-xs transition-colors',
                  isSelected
                    ? 'bg-surface-raised font-semibold text-ink'
                    : 'text-body hover:bg-surface-raised hover:text-ink'
                ]}
              >
                <span>{langOption.nativeName}</span>
                <span class="font-mono text-[10px] text-mute uppercase">{langOption.code}</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Theme Toggle -->
      <button
        type="button"
        class="theme-toggle-btn flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface text-ink hover:bg-surface-raised transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-link cursor-pointer"
        aria-label="Toggle light and dark theme"
        title="Toggle color theme"
      >
        <svg class="sun-icon hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="moon-icon hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label={t.header.menu}
        aria-expanded="false"
        class="flex h-9 w-9 items-center justify-center rounded-md border border-border bg-surface text-ink hover:bg-surface-raised focus:outline-none focus-visible:ring-2 focus-visible:ring-link cursor-pointer"
      >
        <svg id="hamburger-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden border-b border-border bg-surface px-4 py-4 md:hidden">
    <div class="flex flex-col gap-1.5">
      {navDefinitions.map((item) => {
        const itemUrl = getLocalizedPath(currentLang, item.path);
        const isActive = activePath === itemUrl || (item.path === '/' && activePath === homeUrl);
        return (
          <a
            href={itemUrl}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive
                ? 'bg-btn-primary text-btn-primary-text'
                : 'text-body hover:bg-surface-raised hover:text-ink'
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </div>
</header>

<script>
  // Mobile drawer toggle logic
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuBtn && menu && hamburger && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }

  // Language Dropdown Logic (Desktop)
  const deskLangBtn = document.getElementById('desktop-lang-btn');
  const deskLangMenu = document.getElementById('desktop-lang-menu');

  if (deskLangBtn && deskLangMenu) {
    deskLangBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = deskLangMenu.classList.contains('hidden');
      deskLangMenu.classList.toggle('hidden');
      deskLangBtn.setAttribute('aria-expanded', String(isHidden));
    });

    document.addEventListener('click', (e) => {
      if (!deskLangMenu.contains(e.target as Node) && e.target !== deskLangBtn) {
        deskLangMenu.classList.add('hidden');
        deskLangBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Language Dropdown Logic (Mobile)
  const mobLangBtn = document.getElementById('mobile-lang-btn');
  const mobLangMenu = document.getElementById('mobile-lang-menu');

  if (mobLangBtn && mobLangMenu) {
    mobLangBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = mobLangMenu.classList.contains('hidden');
      mobLangMenu.classList.toggle('hidden');
      mobLangBtn.setAttribute('aria-expanded', String(isHidden));
    });

    document.addEventListener('click', (e) => {
      if (!mobLangMenu.contains(e.target as Node) && e.target !== mobLangBtn) {
        mobLangMenu.classList.add('hidden');
        mobLangBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Unified Theme Toggle Logic
  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    const toggles = document.querySelectorAll('.theme-toggle-btn');

    toggles.forEach((btn) => {
      const sun = btn.querySelector('.sun-icon');
      const moon = btn.querySelector('.moon-icon');

      if (isDark) {
        sun?.classList.remove('hidden');
        moon?.classList.add('hidden');
        btn.setAttribute('aria-label', 'Switch to light theme');
        btn.setAttribute('title', 'Switch to light theme (currently Dark)');
      } else {
        sun?.classList.add('hidden');
        moon?.classList.remove('hidden');
        btn.setAttribute('aria-label', 'Switch to dark theme');
        btn.setAttribute('title', 'Switch to dark theme (currently Light)');
      }
    });
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const newTheme = isDark ? 'light' : 'dark';

    if (newTheme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }

    document.documentElement.setAttribute('data-theme', newTheme);
    try {
      localStorage.setItem('theme', newTheme);
    } catch (e) {}

    updateThemeUI();
  }

  // Attach click listeners to all theme toggles
  document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', toggleTheme);
  });

  // Listen to OS theme changes if user has not explicitly set a preference
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) {
      const newTheme = e.matches ? 'dark' : 'light';
      if (newTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      document.documentElement.setAttribute('data-theme', newTheme);
      updateThemeUI();
    }
  });

  // Initial sync on script load
  updateThemeUI();
</script>
