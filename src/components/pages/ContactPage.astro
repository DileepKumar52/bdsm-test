---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { getInfoPagesContent } from '../../i18n/pages/infoPages';
import { getLocalizedPath, type SupportedLanguage } from '../../i18n/languages';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const info = getInfoPagesContent(lang).contact;
const currentPath = getLocalizedPath(lang, '/contact');
---

<Layout
  title={info.metaTitle}
  description={info.metaDescription}
  canonicalPath={currentPath}
  lang={lang}
>
  <Header activePath={currentPath} lang={lang} />

  <main class="flex-1 py-12 md:py-20">
    <div class="pointer-events-none absolute inset-x-0 top-16 h-80 hero-mesh"></div>

    <div class="relative mx-auto max-w-3xl px-4 sm:px-6">
      <!-- Page Header -->
      <div class="mb-10 text-center">
        <span class="rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs uppercase tracking-wider text-mute shadow-xs">
          {info.eyebrow}
        </span>
        <h1 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-[-1.2px] text-ink">
          {info.h1}
        </h1>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-body">
          {info.subtitle}
        </p>
      </div>

      <div class="space-y-8">
        <!-- Direct Contact Card -->
        <div class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-semibold text-ink">{info.directTitle}</h2>
          <p class="mt-2 text-xs sm:text-sm text-body leading-relaxed">
            {info.directDesc}
          </p>
          <div class="mt-4 inline-flex items-center gap-2 rounded-xl border border-border bg-surface-raised px-4 py-2.5 font-mono text-xs text-ink">
            <svg class="h-4 w-4 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="font-medium select-all">contact@freebdsmtest.com</span>
          </div>
        </div>

        <!-- Feedback & Inquiry Form -->
        <div class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-semibold text-ink">{info.formTitle}</h2>
          <p class="mt-1 text-xs text-mute">
            {info.formDesc}
          </p>

          <form id="contact-form" class="mt-6 space-y-4" data-sent-msg={info.sentNotice}>
            <div>
              <label for="contact-topic" class="block text-xs font-medium text-ink mb-1.5">
                {info.topicLabel}
              </label>
              <select
                id="contact-topic"
                name="topic"
                required
                class="w-full rounded-xl border border-border bg-surface-raised px-3.5 py-2.5 text-xs text-ink focus:border-ink focus:bg-surface focus:outline-none transition-colors"
              >
                <option value="feedback">{info.topicFeedback}</option>
                <option value="bug">{info.topicBug}</option>
                <option value="privacy">{info.topicPrivacy}</option>
                <option value="other">{info.topicGeneral}</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-medium text-ink mb-1.5">
                {info.messageLabel}
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder={info.messagePlaceholder}
                class="w-full rounded-xl border border-border bg-surface-raised p-3.5 text-xs text-ink placeholder:text-mute focus:border-ink focus:bg-surface focus:outline-none transition-colors"
              ></textarea>
            </div>

            <button
              type="submit"
              id="contact-submit-btn"
              class="inline-flex items-center gap-2 rounded-full bg-btn-primary px-6 py-2.5 text-xs font-semibold text-btn-primary-text shadow-xs hover:opacity-90 transition-all cursor-pointer"
            >
              <span>{info.submitBtn}</span>
            </button>

            <div id="contact-success" class="hidden mt-3 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-3 text-xs text-emerald-600 dark:text-emerald-400">
              {info.sentNotice}
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBox = document.getElementById('contact-success');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successBox.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        successBox.classList.add('hidden');
      }, 5000);
    });
  }
</script>

