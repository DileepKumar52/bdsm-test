---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { DIMENSION_CATEGORIES } from '../../data/dimensions';
import { getLocalizedDimensions, CATEGORY_TRANSLATIONS } from '../../i18n/dimensions';
import { getDimensionsPageContent } from '../../i18n/pages/dimensions';
import { getLocalizedPath, type SupportedLanguage } from '../../i18n/languages';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const content = getDimensionsPageContent(lang);
const dimensionsMap = getLocalizedDimensions(lang);
const dimensionList = Object.values(dimensionsMap);
const catTrans = CATEGORY_TRANSLATIONS[lang] || CATEGORY_TRANSLATIONS.en;
const currentPath = getLocalizedPath(lang, '/dimensions');
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  canonicalPath={currentPath}
  lang={lang}
>
  <Header activePath={currentPath} lang={lang} />

  <main class="flex-1 py-10 md:py-16">
    <div class="pointer-events-none absolute inset-x-0 top-16 h-80 hero-mesh"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6">
      <!-- Section Header -->
      <div class="mb-12 text-center">
        <span class="rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs uppercase tracking-wider text-mute shadow-xs">
          {content.header.eyebrow}
        </span>
        <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-[-1.2px] text-ink">
          {content.header.h1}
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-body">
          {content.header.subtitle}
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mb-10 flex flex-wrap justify-center gap-2" id="filter-tabs">
        {DIMENSION_CATEGORIES.map((cat, idx) => {
          const localizedCategoryLabel = catTrans[cat] || cat;
          return (
            <button
              type="button"
              data-category={cat}
              class:list={[
                'category-tab-btn rounded-full px-4 py-1.5 text-xs font-medium transition-all border cursor-pointer',
                idx === 0
                  ? 'bg-btn-primary text-btn-primary-text border-btn-primary'
                  : 'bg-surface text-body border-border hover:border-ink hover:text-ink'
              ]}
            >
              {localizedCategoryLabel}
            </button>
          );
        })}
      </div>

      <!-- Dimensions Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="dimensions-grid">
        {dimensionList.map((dim) => {
          const locCat = catTrans[dim.category] || dim.category;
          return (
            <article
              class="dimension-card rounded-2xl border border-border bg-surface p-6 shadow-xs hover:border-ink transition-all flex flex-col justify-between"
              data-category={dim.category}
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-mute">
                    {locCat}
                  </span>
                  <span class="rounded-full bg-surface-raised px-2.5 py-0.5 font-mono text-[10px] text-ink font-medium border border-border">
                    {dim.roleType.toUpperCase()}
                  </span>
                </div>

                <h2 class="text-xl font-semibold tracking-tight text-ink">
                  {dim.name}
                </h2>
                <p class="mt-2 text-xs leading-relaxed text-body">
                  {dim.shortDescription}
                </p>

                <div class="mt-4 pt-4 border-t border-border space-y-3">
                  <p class="text-xs leading-relaxed text-body">
                    {dim.fullDescription}
                  </p>

                  <div>
                    <h3 class="text-xs font-semibold text-ink mb-1.5">{content.card.characteristicsLabel}</h3>
                    <ul class="text-xs text-body space-y-1 list-disc list-inside">
                      {dim.characteristics.map((char) => (
                        <li>{char}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-border text-xs">
                <div class="text-ink font-medium mb-1">{content.card.communicationLabel}</div>
                <p class="text-mute leading-normal">{dim.communicationTips}</p>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Bottom Take Test CTA -->
      <div class="mt-16 rounded-2xl border border-border bg-surface-raised p-8 text-center">
        <h2 class="text-2xl font-semibold tracking-tight text-ink">
          {content.cta.title}
        </h2>
        <p class="mx-auto mt-2 max-w-xl text-xs sm:text-sm text-body">
          {content.cta.subtitle}
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href={getLocalizedPath(lang, '/test/quick')}
            class="rounded-full bg-btn-primary px-6 py-2.5 text-xs font-semibold text-btn-primary-text hover:opacity-90 transition-colors shadow-xs"
          >
            {content.cta.quickBtn}
          </a>
          <a
            href={getLocalizedPath(lang, '/test/comprehensive')}
            class="rounded-full border border-border bg-surface px-6 py-2.5 text-xs font-semibold text-ink hover:bg-surface-raised transition-colors"
          >
            {content.cta.compBtn}
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<script>
  // Category Filter Tabs Logic
  const tabs = document.querySelectorAll('.category-tab-btn');
  const cards = document.querySelectorAll('.dimension-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selectedCategory = tab.getAttribute('data-category');

      // Update active tab styles
      tabs.forEach((t) => {
        t.classList.remove('bg-btn-primary', 'text-btn-primary-text', 'border-btn-primary');
        t.classList.add('bg-surface', 'text-body', 'border-border');
      });
      tab.classList.remove('bg-surface', 'text-body', 'border-border');
      tab.classList.add('bg-btn-primary', 'text-btn-primary-text', 'border-btn-primary');

      // Filter cards
      cards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        if (selectedCategory === 'All Categories' || cardCategory === selectedCategory) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

