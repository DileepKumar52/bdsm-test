---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { getInfoPagesContent } from '../../i18n/pages/infoPages';
import { getLocalizedPath, type SupportedLanguage } from '../../i18n/languages';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const info = getInfoPagesContent(lang).disclaimer;
const currentPath = getLocalizedPath(lang, '/disclaimer');
---

<Layout
  title={info.metaTitle}
  description={info.metaDescription}
  canonicalPath={currentPath}
  lang={lang}
>
  <Header activePath={currentPath} lang={lang} />

  <main class="flex-1 py-12 md:py-20">
    <div class="pointer-events-none absolute inset-x-0 top-16 h-80 hero-mesh"></div>

    <div class="relative mx-auto max-w-4xl px-4 sm:px-6">
      <div class="mb-10">
        <span class="rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs uppercase tracking-wider text-mute shadow-xs">
          Legal Notice
        </span>
        <h1 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-[-1.2px] text-ink">
          {info.h1}
        </h1>
        <p class="mt-2 font-mono text-xs text-mute">{info.lastUpdated}</p>
      </div>

      <div class="space-y-6">
        <section class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-semibold text-ink">{info.importantTitle}</h2>
          <p class="mt-3 text-sm text-body leading-relaxed">{info.importantDesc}</p>
        </section>

        <section class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-semibold text-ink">{info.noMedicalTitle}</h2>
          <p class="mt-3 text-sm text-body leading-relaxed">{info.noMedicalDesc}</p>
        </section>

        <section class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-semibold text-ink">{info.safetyTitle}</h2>
          <p class="mt-3 text-sm text-body leading-relaxed">{info.safetyDesc}</p>
        </section>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

