---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { getInfoPagesContent } from '../../i18n/pages/infoPages';
import { getLocalizedPath, type SupportedLanguage } from '../../i18n/languages';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const info = getInfoPagesContent(lang).notFound;
const currentPath = getLocalizedPath(lang, '/404');
---

<Layout
  title={info.metaTitle}
  description={info.metaDescription}
  noindex={true}
  canonicalPath={currentPath}
  lang={lang}
>
  <Header activePath={currentPath} lang={lang} />

  <main class="flex-1 flex items-center justify-center py-20 md:py-32">
    <div class="pointer-events-none absolute inset-x-0 top-16 h-80 hero-mesh"></div>

    <div class="relative mx-auto max-w-lg px-4 sm:px-6 text-center">
      <div class="inline-flex items-center justify-center rounded-2xl border border-border bg-surface-raised px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-mute mb-4">
        Error 404
      </div>

      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-1.5px] text-ink">
        {info.h1}
      </h1>

      <p class="mt-4 text-sm text-body leading-relaxed">
        {info.message}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={getLocalizedPath(lang, '/')}
          class="rounded-full bg-btn-primary px-6 py-2.5 text-xs font-semibold text-btn-primary-text hover:opacity-90 transition-all shadow-xs"
        >
          {info.backHomeBtn}
        </a>
        <a
          href={getLocalizedPath(lang, '/test/quick')}
          class="rounded-full border border-border bg-surface px-6 py-2.5 text-xs font-semibold text-ink hover:bg-surface-raised transition-all"
        >
          {info.takeTestBtn}
        </a>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

