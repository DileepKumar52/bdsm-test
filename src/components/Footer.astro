---
import {
  getLanguageFromPath,
  getLocalizedPath,
  type SupportedLanguage
} from '../i18n/languages';
import { getTranslations } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const currentLang: SupportedLanguage = Astro.props.lang || getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(currentLang);
---

<footer class="mt-auto border-t border-border bg-canvas py-14 text-body transition-colors">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Col 1: Brand & Purpose -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-btn-primary font-mono text-xs font-semibold text-btn-primary-text">
            BT
          </div>
          <span class="font-semibold tracking-[-0.4px] text-ink">BDSM Test</span>
        </div>
        <p class="text-xs leading-relaxed text-body">
          {t.footer.brandBio}
        </p>
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-[11px] text-ink shadow-xs">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
          {t.footer.privacyBadge}
        </div>
      </div>

      <!-- Col 2: Assessments & Tools -->
      <div>
        <h3 class="mb-3.5 font-mono text-xs font-semibold uppercase tracking-wider text-ink">
          {t.footer.colAssessments}
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href={getLocalizedPath(currentLang, '/')} class="hover:text-ink transition-colors">
              {t.footer.homeOverview}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(currentLang, '/test/quick')} class="hover:text-ink transition-colors">
              {t.footer.quickTestName}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(currentLang, '/test/comprehensive')} class="hover:text-ink transition-colors">
              {t.footer.comprehensiveTestName}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(currentLang, '/dimensions')} class="hover:text-ink transition-colors">
              {t.footer.dimensionsName}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(currentLang, '/compare')} class="hover:text-ink transition-colors">
              {t.footer.compareName}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: About & Support -->
      <div>
        <h3 class="mb-3.5 font-mono text-xs font-semibold uppercase tracking-wider text-ink">
          {t.footer.colAbout}
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href={getLocalizedPath(currentLang, '/about')} class="hover:text-ink transition-colors">
              {t.footer.aboutUs}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(currentLang, '/contact')} class="hover:text-ink transition-colors">
              {t.footer.contact}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(currentLang, '/disclaimer')} class="hover:text-ink transition-colors">
              {t.footer.disclaimer}
            </a>
          </li>
          <li>
            <span class="text-mute block pt-1">{t.footer.ethicalPrinciples}</span>
          </li>
        </ul>
      </div>

      <!-- Col 4: Legal & Policy -->
      <div>
        <h3 class="mb-3.5 font-mono text-xs font-semibold uppercase tracking-wider text-ink">
          {t.footer.colLegal}
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href={getLocalizedPath(currentLang, '/privacy')} class="hover:text-ink transition-colors">
              {t.footer.privacyPolicy}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(currentLang, '/terms')} class="hover:text-ink transition-colors">
              {t.footer.termsOfService}
            </a>
          </li>
          <li>
            <span class="text-mute block pt-1">
              &copy; {new Date().getFullYear()} BDSM Test. {t.footer.copyright}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Disclaimer Notice -->
    <div class="mt-12 border-t border-border pt-6 text-center text-[11px] text-mute">
      <p>
        Strictly for consenting adults (18+). Educational self-discovery assessment. Not medical, diagnostic, or clinical psychological advice.
      </p>
    </div>
  </div>
</footer>
