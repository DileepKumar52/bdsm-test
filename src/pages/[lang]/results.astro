---
import ResultsPage from '../../components/pages/ResultsPage.astro';
import { NON_DEFAULT_LANGUAGES, type SupportedLanguage } from '../../i18n/languages';

export function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---

<ResultsPage lang={lang as SupportedLanguage} />

