---
import TestPage from '../../../components/pages/TestPage.astro';
import { NON_DEFAULT_LANGUAGES, type SupportedLanguage } from '../../../i18n/languages';

export function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
---

<TestPage mode="comprehensive" lang={lang as SupportedLanguage} />

