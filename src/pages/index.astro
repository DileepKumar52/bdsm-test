---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DIMENSIONS } from '../data/dimensions';

const previewDimensions = [
  DIMENSIONS['dominant'],
  DIMENSIONS['submissive'],
  DIMENSIONS['switch'],
  DIMENSIONS['sadist'],
  DIMENSIONS['masochist'],
  DIMENSIONS['rigger'],
  DIMENSIONS['rope_bunny'],
  DIMENSIONS['primal_hunter'],
  DIMENSIONS['praise_receiver'],
];

const faqItems = [
  {
    question: 'What is a BDSM test?',
    answer:
      'A BDSM test is an exploratory self-assessment tool designed for consenting adults to evaluate their personal interests, boundaries, and inclinations across the spectrum of BDSM (Bondage & Discipline, Dominance & Submission, Sadism & Masochism). By answering standardized scenario-based questions, individuals can identify specific relationship roles and communicate their intimate preferences more clearly with partners.'
  },
  {
    question: 'What is the BDSM test and how did it originate?',
    answer:
      'The BDSM test refers to the popular genre of online kink questionnaires that emerged in the early 2000s to help people discover where they fit within alternative relationship dynamics. Our modern BDSM test enhances this legacy by offering client-side privacy, multi-dimensional weighted scoring, and 20 distinct categories that go far beyond primitive top/bottom dichotomies.'
  },
  {
    question: 'What is BDSM test meaning and how should results be interpreted?',
    answer:
      'The meaning of BDSM test results lies in personal reflection and dialogue rather than rigid labels. Your scores reflect self-reported comfort levels and curiosities on a 0% to 100% scale at this specific moment. A high score represents an affinity to explore, not a mandate or an obligation, while a low score highlights clear boundaries.'
  },
  {
    question: 'What are the primary BDSM test categories evaluated?',
    answer:
      'Our assessment measures 20 nuanced categories organized into four realms: Power Exchange (Dominant, Submissive, Switch, Master/Mistress, Slave, Vanilla), Physical & Sensation (Sadist, Masochist, Rigger, Rope Bunny, Sensory Explorer), Psychological & Verbal (Degrader, Degradee, Praise Giver, Praise Receiver), and Exploration (Primal Hunter, Primal Prey, Caregiver, Pet/Ageplay, Voyeur/Exhibitionist).'
  },
  {
    question: 'Is this BDSM test free and completely anonymous?',
    answer:
      'Yes, our BDSM test is 100% free with no paywalls, hidden fees, or email requirements. More importantly, all scoring calculations take place entirely within your local browser memory. Your answers and intimate preferences are never sent to or stored on our servers, ensuring total privacy.'
  },
  {
    question: 'How do partners compare their BDSM test results?',
    answer:
      'After completing the test, you receive an encoded, tamper-proof link that you can share with a partner. Using our Partner Sync feature, you can view your scorecards side-by-side to highlight complementary synergies (such as Sadist and Masochist or Praise Giver and Praise Receiver) and identify areas requiring proactive boundary negotiation.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'BDSM Test',
  url: 'https://bdsmtest.org/',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'All modern web browsers',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  description:
    'Free, anonymous, and client-side online BDSM test evaluating 20 nuanced relationship roles and intimate dynamics.'
};
---

<Layout
  title="BDSM Test — Free BDSM Test Online & Dynamics Assessment"
  description="Take the free BDSM test online to discover your kink BDSM test results, explore 20 nuanced BDSM test categories, and understand the meaning of your intimate dynamics with 100% client-side privacy."
  canonicalPath="/"
  structuredData={[webAppSchema, faqSchema]}
>
  <Header activePath="/" />

  <main class="flex-1">
    <!-- 1. Hero Section with Primary Keyword Targeting -->
    <section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28">
      <div class="pointer-events-none absolute inset-x-0 -top-24 h-[520px] hero-mesh"></div>

      <div class="relative mx-auto max-w-5xl px-4 sm:px-6 text-center">
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/90 px-3.5 py-1 backdrop-blur-xs mb-6 shadow-xs">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-mono text-xs font-medium uppercase tracking-wider text-ink">
            Free BDSM Test Online
          </span>
          <span class="text-border">|</span>
          <span class="text-xs text-mute">100% Client-Side Privacy • 18+</span>
        </div>

        <!-- Single Descriptive H1 with Primary Keyword -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-[-2.4px] text-ink leading-[1.08] max-w-4xl mx-auto">
          BDSM Test: Free, Anonymous Online Dynamics Assessment
        </h1>

        <!-- Subtitle & Introductory Text -->
        <p class="mx-auto mt-6 max-w-2xl text-base sm:text-lg text-body leading-relaxed">
          Discover your relationship roles, power balance affinities, and personal boundaries with our comprehensive kink BDSM test. Evaluate 20 distinct categories with reliable, non-arbitrary scoring—completely free, private, and with zero registration.
        </p>

        <!-- CTAs: Quick vs Comprehensive -->
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/test/quick"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-btn-primary px-8 py-3.5 text-sm font-semibold text-btn-primary-text shadow-xs hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
          >
            <span>Take Quick BDSM Test</span>
            <span class="rounded bg-white/20 px-2 py-0.5 font-mono text-[11px] font-normal text-btn-primary-text">24 Qs • ~3 min</span>
          </a>

          <a
            href="/test/comprehensive"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-border bg-surface px-8 py-3.5 text-sm font-semibold text-ink hover:bg-surface-raised hover:border-ink transition-all cursor-pointer"
          >
            <span>Comprehensive BDSM Test</span>
            <span class="rounded bg-surface-raised px-2 py-0.5 font-mono text-[11px] font-normal text-body border border-border">64 Qs • ~10 min</span>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="mt-12 flex flex-wrap items-center justify-center gap-8 text-xs text-mute">
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>No Server Storage or Tracking</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Free BDSM Test — No Sign-Up</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Instant Results &amp; Partner Sync</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Dual Test Selection Section -->
    <section class="border-t border-border bg-surface py-16 transition-colors">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="mb-12 text-center">
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-mute">
            Choose Your Depth
          </span>
          <h2 class="mt-2 text-3xl font-semibold tracking-[-1.28px] text-ink">
            Two Formats Designed for Your Schedule
          </h2>
          <p class="mx-auto mt-2 max-w-xl text-sm text-body">
            Whether you want a rapid overview of your core power dynamics or an exhaustive breakdown of subtle kink archetypes, both tests are free and private.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Quick Card -->
          <div class="relative rounded-2xl border border-border bg-surface-raised p-8 flex flex-col justify-between hover:border-ink transition-all">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="rounded-full bg-surface border border-border px-3 py-1 font-mono text-xs font-medium text-ink">
                  Quick Assessment
                </span>
                <span class="text-xs text-mute">24 Questions • ~3 min</span>
              </div>
              <h3 class="text-2xl font-semibold tracking-[-0.4px] text-ink">
                Quick BDSM Test: Core Orientation
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-body">
                Best for those wanting a fast snapshot of their baseline dominant, submissive, switch, or sensory preferences without a lengthy time commitment.
              </p>

              <ul class="mt-6 space-y-2.5 text-xs text-body">
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span> Evaluates core power-exchange spectrum
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span> Intuitive 5-point Likert response scale
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span> Immediate BDSM test results breakdown
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span> Fully shareable private URL token
                </li>
              </ul>
            </div>

            <div class="mt-8 pt-6 border-t border-border">
              <a
                href="/test/quick"
                class="flex w-full items-center justify-center rounded-full bg-btn-primary py-3 text-xs font-semibold text-btn-primary-text hover:opacity-90 transition-colors shadow-xs"
              >
                Start Quick BDSM Test (Free)
              </a>
            </div>
          </div>

          <!-- Comprehensive Card -->
          <div class="relative rounded-2xl border-2 border-border-strong bg-surface p-8 flex flex-col justify-between shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
            <div class="absolute -top-3 right-6 rounded-full bg-btn-primary px-3 py-0.5 font-mono text-[10px] font-semibold uppercase text-btn-primary-text tracking-wider shadow-xs">
              Recommended
            </div>

            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="rounded-full bg-surface-raised border border-border px-3 py-1 font-mono text-xs font-medium text-ink">
                  Comprehensive Assessment
                </span>
                <span class="text-xs text-mute">64 Questions • ~10 min</span>
              </div>
              <h3 class="text-2xl font-semibold tracking-[-0.4px] text-ink">
                Comprehensive BDSM Test: Deep Analysis
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-body">
                The ultimate in-depth exploration covering all 20 BDSM test categories, subtle psychological desires, protocol structures, and sensation boundaries.
              </p>

              <ul class="mt-6 space-y-2.5 text-xs text-body">
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span> Exhaustive 64-question assessment
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span> Granular ratings across all 20 dimensions
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span> Personalized communication and safety tips
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span> Side-by-side partner compatibility sync
                </li>
              </ul>
            </div>

            <div class="mt-8 pt-6 border-t border-border">
              <a
                href="/test/comprehensive"
                class="flex w-full items-center justify-center rounded-full bg-btn-primary py-3 text-xs font-semibold text-btn-primary-text hover:opacity-90 transition-colors shadow-xs"
              >
                Start Comprehensive BDSM Test
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Key Benefits & Technical Quality -->
    <section class="border-t border-border bg-surface-raised py-20 transition-colors">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="mb-14 text-center">
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-mute">
            Engineered for Integrity
          </span>
          <h2 class="mt-2 text-3xl font-semibold tracking-[-1.28px] text-ink">
            Why Take Our Online BDSM Test?
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-sm text-body">
            Built with modern web standards, ethical design, and complete transparency.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Benefit 1 -->
          <div class="rounded-2xl border border-border bg-surface p-6 shadow-xs hover:border-ink transition-all">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-surface-raised border border-border text-ink mb-4">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 004 11m0 0a8 8 0 0015.171 3.571" />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-ink">100% Client-Side Privacy</h3>
            <p class="mt-2 text-xs leading-relaxed text-body">
              Unlike other quizzes, your questionnaire answers never leave your browser. All calculations run locally on your device for absolute confidentiality.
            </p>
          </div>

          <!-- Benefit 2 -->
          <div class="rounded-2xl border border-border bg-surface p-6 shadow-xs hover:border-ink transition-all">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-surface-raised border border-border text-ink mb-4">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-ink">Multidimensional Scoring</h3>
            <p class="mt-2 text-xs leading-relaxed text-body">
              Calculated using non-arbitrary mathematical weightings and cross-correlations, accurately modeling complex dynamics like versatile Switches and Devotees.
            </p>
          </div>

          <!-- Benefit 3 -->
          <div class="rounded-2xl border border-border bg-surface p-6 shadow-xs hover:border-ink transition-all">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-surface-raised border border-border text-ink mb-4">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-ink">Partner Compatibility Sync</h3>
            <p class="mt-2 text-xs leading-relaxed text-body">
              Compare your BDSM test results with a partner side-by-side using private URL parameters without exchanging passwords or saving data to external servers.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Dimension Categories Preview Section -->
    <section class="border-t border-border bg-surface py-20 transition-colors">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-mute">
              Taxonomy &amp; Dimensions
            </span>
            <h2 class="mt-2 text-3xl font-semibold tracking-[-1.28px] text-ink">
              BDSM Test Categories &amp; Dimensions
            </h2>
            <p class="mt-1 text-sm text-body">
              Explore how our assessment evaluates 20 nuanced archetypes across the BDSM spectrum.
            </p>
          </div>
          <a
            href="/dimensions"
            class="text-xs font-semibold text-link hover:underline inline-flex items-center gap-1"
          >
            <span>View All 20 BDSM Categories</span>
            <span>→</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {previewDimensions.map((dim) => (
            <div class="rounded-xl border border-border bg-surface-raised p-5 hover:border-ink transition-all">
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-[10px] uppercase tracking-wider text-mute">
                  {dim.category}
                </span>
                <span class="rounded bg-surface border border-border px-1.5 py-0.5 font-mono text-[9px] text-ink font-medium">
                  {dim.roleType.toUpperCase()}
                </span>
              </div>
              <h3 class="text-base font-semibold text-ink">{dim.name}</h3>
              <p class="mt-1.5 text-xs text-body leading-relaxed line-clamp-2">
                {dim.shortDescription}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Comprehensive FAQ Section (Accurately Mirrored in JSON-LD Schema) -->
    <section class="border-t border-border bg-surface-raised py-20 transition-colors" id="faq">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="mb-12 text-center">
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-mute">
            Common Inquiries
          </span>
          <h2 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-[-1.28px] text-ink">
            Frequently Asked Questions About the BDSM Test
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-sm text-body">
            Original, clear answers regarding BDSM test meaning, results, privacy, and assessment categories.
          </p>
        </div>

        <div class="space-y-4">
          {faqItems.map((faq) => (
            <details class="group rounded-2xl border border-border bg-surface p-6 transition-all hover:border-ink shadow-xs">
              <summary class="flex items-center justify-between cursor-pointer select-none text-base font-semibold text-ink gap-4">
                <span>{faq.question}</span>
                <svg
                  class="h-4 w-4 text-mute transition-transform group-open:rotate-180 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="mt-4 pt-4 border-t border-border text-xs sm:text-sm text-body leading-relaxed">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Consent & Ethical Principles Strip -->
    <section class="border-t border-border bg-surface py-16 transition-colors">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="rounded-2xl border border-border bg-surface-raised p-8 md:p-12 shadow-xs">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div>
              <span class="rounded bg-btn-primary px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase text-btn-primary-text">
                Ethical Foundations
              </span>
              <h2 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-[-0.8px] text-ink">
                Consent and Communication Are Paramount
              </h2>
              <p class="mt-3 text-xs sm:text-sm leading-relaxed text-body">
                A BDSM test is an aid for mutual dialogue, never an obligation or permission slip. Responsible kink requires ongoing, voluntary consent, active safewords, and dedicated aftercare.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="rounded-xl border border-border bg-surface p-4">
                <div class="font-semibold text-ink">SSC Model</div>
                <p class="mt-1 text-mute">Safe, Sane, and Consensual principles for baseline interactions.</p>
              </div>
              <div class="rounded-xl border border-border bg-surface p-4">
                <div class="font-semibold text-ink">RACK Model</div>
                <p class="mt-1 text-mute">Risk-Aware Consensual Kink recognizing personal responsibility.</p>
              </div>
              <div class="rounded-xl border border-border bg-surface p-4">
                <div class="font-semibold text-ink">Safewords</div>
                <p class="mt-1 text-mute">Clear, unambiguous verbal cues to modify or immediately halt scenes.</p>
              </div>
              <div class="rounded-xl border border-border bg-surface p-4">
                <div class="font-semibold text-ink">Aftercare</div>
                <p class="mt-1 text-mute">Post-scene emotional grounding, physical comfort, and hydration.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Bottom CTA Band -->
    <section class="border-t border-border bg-surface py-20 text-center transition-colors">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-[-1.5px] text-ink">
          Ready to Take the Free BDSM Test Online?
        </h2>
        <p class="mt-4 text-sm text-body">
          Start your anonymous assessment in seconds. Choose between the 3-minute Quick Test or the 10-minute Comprehensive Assessment.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/test/quick"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-full bg-btn-primary px-8 py-3.5 text-xs font-semibold text-btn-primary-text shadow-xs hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
          >
            Start Quick BDSM Test (3 min)
          </a>
          <a
            href="/test/comprehensive"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-full border border-border bg-surface px-8 py-3.5 text-xs font-semibold text-ink hover:bg-surface-raised transition-all cursor-pointer"
          >
            Start Comprehensive Assessment
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
