---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 — Page Not Found | BDSM Test"
  description="The requested page could not be found. Return to the BDSM Test homepage or choose an assessment."
  noindex={true}
  canonicalPath="/404"
>
  <Header />

  <main class="flex-1 flex items-center justify-center py-20 md:py-32">
    <div class="pointer-events-none absolute inset-x-0 top-16 h-80 hero-mesh"></div>

    <div class="relative mx-auto max-w-lg px-4 sm:px-6 text-center">
      <div class="inline-flex items-center justify-center rounded-2xl border border-border bg-surface-raised px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-mute mb-4">
        Error 404
      </div>

      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-1.5px] text-ink">
        Page not found
      </h1>

      <p class="mt-4 text-sm text-body leading-relaxed">
        The link you followed may be incorrect, the page might have moved, or the test result parameters might be incomplete.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="rounded-full bg-btn-primary px-6 py-2.5 text-xs font-semibold text-btn-primary-text hover:opacity-90 transition-all shadow-xs"
        >
          Return to Homepage
        </a>
        <a
          href="/test/quick"
          class="rounded-full border border-border bg-surface px-6 py-2.5 text-xs font-semibold text-ink hover:bg-surface-raised transition-all"
        >
          Take Quick Test
        </a>
      </div>

      <div class="mt-10 border-t border-border pt-6 flex justify-center gap-6 text-xs text-mute">
        <a href="/dimensions" class="hover:text-ink transition-colors">Dimensions Glossary</a>
        <a href="/compare" class="hover:text-ink transition-colors">Partner Sync</a>
        <a href="/contact" class="hover:text-ink transition-colors">Contact Support</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

