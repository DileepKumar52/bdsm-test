---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us — BDSM Test Feedback & Inquiries"
  description="Get in touch with the BDSM Test team for feedback, question suggestions, bug reports, or privacy inquiries."
  canonicalPath="/contact"
>
  <Header activePath="/contact" />

  <main class="flex-1 py-12 md:py-20">
    <div class="pointer-events-none absolute inset-x-0 top-16 h-80 hero-mesh"></div>

    <div class="relative mx-auto max-w-3xl px-4 sm:px-6">
      <!-- Page Header -->
      <div class="mb-10 text-center">
        <span class="rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs uppercase tracking-wider text-mute shadow-xs">
          Get in Touch
        </span>
        <h1 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-[-1.2px] text-ink">
          Contact & Feedback
        </h1>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-body">
          We welcome your feedback, question suggestions, bug reports, and accessibility improvements.
        </p>
      </div>

      <div class="space-y-8">
        <!-- Direct Contact Card -->
        <div class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-semibold text-ink">Direct Communication</h2>
          <p class="mt-2 text-xs sm:text-sm text-body leading-relaxed">
            For general inquiries, bug reports, or partnership suggestions, email us directly at:
          </p>
          <div class="mt-4 inline-flex items-center gap-2 rounded-xl border border-border bg-surface-raised px-4 py-2.5 font-mono text-xs text-ink">
            <svg class="h-4 w-4 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="font-medium select-all">contact@bdsmtest.local</span>
          </div>
        </div>

        <!-- Feedback & Inquiry Form -->
        <div class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-semibold text-ink">Send a Message</h2>
          <p class="mt-1 text-xs text-mute">
            Submit your thoughts or feedback. We read every thoughtful message.
          </p>

          <form id="contact-form" class="mt-6 space-y-4">
            <div>
              <label for="contact-topic" class="block text-xs font-medium text-ink mb-1.5">
                Topic
              </label>
              <select
                id="contact-topic"
                name="topic"
                required
                class="w-full rounded-xl border border-border bg-surface-raised px-3.5 py-2.5 text-xs text-ink focus:border-ink focus:bg-surface focus:outline-none transition-colors"
              >
                <option value="feedback">Questionnaire Feedback & Suggestions</option>
                <option value="bug">Bug Report / Technical Issue</option>
                <option value="privacy">Privacy & Data Handling Inquiry</option>
                <option value="other">General Question</option>
              </select>
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-medium text-ink mb-1.5">
                Your Email <span class="text-mute font-normal">(optional, for replies only)</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="you@example.com"
                class="w-full rounded-xl border border-border bg-surface-raised px-3.5 py-2.5 text-xs text-ink placeholder:text-mute focus:border-ink focus:bg-surface focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-medium text-ink mb-1.5">
                Message <span class="text-error">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="Share your feedback, bug details, or thoughts..."
                class="w-full rounded-xl border border-border bg-surface-raised p-3.5 text-xs text-ink placeholder:text-mute focus:border-ink focus:bg-surface focus:outline-none transition-colors"
              ></textarea>
            </div>

            <button
              type="submit"
              id="contact-submit-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center rounded-full bg-btn-primary px-6 py-2.5 text-xs font-semibold text-btn-primary-text hover:opacity-90 transition-all shadow-xs cursor-pointer"
            >
              Send Message
            </button>
          </form>

          <!-- Success Confirmation -->
          <div id="contact-success" class="hidden mt-6 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-xs text-emerald-600 dark:text-emerald-400">
            <div class="flex items-center gap-2 font-semibold">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Thank you! Your message has been received.
            </div>
            <p class="mt-1">We appreciate your feedback to help keep BDSM Test accurate, private, and respectful.</p>
          </div>
        </div>

        <!-- Privacy Reminder -->
        <div class="rounded-xl border border-border bg-surface-raised p-4 text-xs text-mute flex items-center gap-3">
          <svg class="h-4 w-4 text-ink shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Sending feedback does not link your identity to any test results. Your assessment responses remain strictly client-side on your device.</span>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBox = document.getElementById('contact-success');
  const submitBtn = document.getElementById('contact-submit-btn');

  if (form && successBox && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Client-side confirmation
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
    });
  }
</script>

