---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DIMENSIONS, DIMENSION_CATEGORIES } from '../data/dimensions';

const dimensionList = Object.values(DIMENSIONS);
---

<Layout
  title="BDSM Test Categories & Dimensions Library — Complete Kink Glossary"
  description="Explore the complete guide to all 20 BDSM test categories and dimensions. Detailed definitions of Dominant, Submissive, Switch, Sadist, Masochist, and more."
  canonicalPath="/dimensions"
>
  <Header activePath="/dimensions" />

  <main class="flex-1 py-10 md:py-16">
    <div class="pointer-events-none absolute inset-x-0 top-16 h-80 hero-mesh"></div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6">
      <!-- Section Header -->
      <div class="mb-12 text-center">
        <span class="rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs uppercase tracking-wider text-mute shadow-xs">
          Taxonomy &amp; Knowledge Base
        </span>
        <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-[-1.2px] text-ink">
          BDSM Test Categories &amp; Dimensions Library
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-body">
          Consensual BDSM encompasses a rich spectrum of psychological, emotional, and physical roles. Explore each dimension's authentic meaning, complementary pairings, and essential safety considerations.
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mb-10 flex flex-wrap justify-center gap-2" id="filter-tabs">
        {DIMENSION_CATEGORIES.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class:list={[
              'category-tab-btn rounded-full px-4 py-1.5 text-xs font-medium transition-all border cursor-pointer',
              idx === 0
                ? 'bg-btn-primary text-btn-primary-text border-btn-primary'
                : 'bg-surface text-body border-border hover:border-ink hover:text-ink'
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Dimensions Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="dimensions-grid">
        {dimensionList.map((dim) => (
          <article
            class="dimension-card rounded-2xl border border-border bg-surface p-6 shadow-xs hover:border-ink transition-all flex flex-col justify-between"
            data-category={dim.category}
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="font-mono text-[11px] uppercase tracking-wider text-mute">
                  {dim.category}
                </span>
                <span class="rounded-full bg-surface-raised px-2.5 py-0.5 font-mono text-[10px] text-ink font-medium border border-border">
                  {dim.roleType.toUpperCase()}
                </span>
              </div>

              <h2 class="text-xl font-semibold tracking-tight text-ink">
                {dim.name}
              </h2>
              <p class="mt-2 text-xs leading-relaxed text-body">
                {dim.shortDescription}
              </p>

              <div class="mt-4 pt-4 border-t border-border space-y-3">
                <p class="text-xs leading-relaxed text-body">
                  {dim.fullDescription}
                </p>

                <div>
                  <h3 class="text-xs font-semibold text-ink mb-1.5">Common Characteristics:</h3>
                  <ul class="text-xs text-body space-y-1 list-disc list-inside">
                    {dim.characteristics.map((char) => (
                      <li>{char}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-border text-xs">
              <div class="text-ink font-medium mb-1">Communication & Negotiation:</div>
              <p class="text-mute leading-normal">{dim.communicationTips}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- Bottom Take Test CTA -->
      <div class="mt-16 rounded-2xl border border-border bg-surface p-8 md:p-12 text-center shadow-xs">
        <h3 class="text-2xl font-semibold tracking-tight text-ink">
          Ready to discover where you fall on this spectrum?
        </h3>
        <p class="mx-auto mt-2 max-w-md text-xs leading-relaxed text-body">
          Take our anonymous, client-side assessment in 3 to 10 minutes.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href="/test/quick"
            class="rounded-full bg-btn-primary px-6 py-2.5 text-xs font-semibold text-btn-primary-text hover:opacity-90 transition-colors shadow-xs"
          >
            Take Quick Test (3 min)
          </a>
          <a
            href="/test/comprehensive"
            class="rounded-full border border-border bg-surface px-6 py-2.5 text-xs font-semibold text-ink hover:bg-surface-raised transition-colors"
          >
            Take Comprehensive Assessment
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const tabBtns = document.querySelectorAll('.category-tab-btn');
  const cards = document.querySelectorAll('.dimension-card');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabBtns.forEach((b) => {
        b.classList.remove('bg-btn-primary', 'text-btn-primary-text', 'border-btn-primary');
        b.classList.add('bg-surface', 'text-body', 'border-border');
      });
      btn.classList.add('bg-btn-primary', 'text-btn-primary-text', 'border-btn-primary');
      btn.classList.remove('bg-surface', 'text-body', 'border-border');

      const selectedCat = btn.getAttribute('data-category') || 'All';

      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (selectedCat === 'All' || cardCat === selectedCat) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
